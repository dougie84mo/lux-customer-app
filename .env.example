# ============================================================================
# Expo client env (customer-app/.env)
# ----------------------------------------------------------------------------
# Loaded into the app at runtime. Anything prefixed EXPO_PUBLIC_ SHIPS TO THE
# CLIENT — never put a secret here.
#
# Client values are the whole file. This app calls DB RPCs only; the schema and
# Edge Functions are owned by ../app/supabase/, and so are their secrets.
# ============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe environment FALLBACK: test | live (default test). Since 0163 the SERVER
# decides test vs live per business/user — `stripe-config` returns the mode +
# publishable key after sign-in, and every client_secret comes with its own
# (lib/stripeMode.ts, lib/checkout.ts). These three vars only cover the window
# before the server has answered (pre-sign-in, or a dev box offline); the
# server's key always wins once it arrives. Restart Metro after a change —
# EXPO_PUBLIC_* is inlined at build time.
EXPO_PUBLIC_STRIPE_MODE=test
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# Fallback for an un-migrated .env — used only when the pair above is unset.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry crash/error reporting. The DSN is a client-side public value (safe to
# ship). Leave blank to keep Sentry wired-but-dark; set it to start reporting.
# Build-time source-map upload additionally needs SENTRY_ORG / SENTRY_PROJECT /
# SENTRY_AUTH_TOKEN in the EAS build env (NOT here — the auth token is a secret).
EXPO_PUBLIC_SENTRY_DSN=
